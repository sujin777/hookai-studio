# Gemini API
GEMINI_API_KEY=your_gemini_api_key_here

# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# Paddle Billing (Sandbox: https://sandbox-vendors.paddle.com)
# Client-side token MUST start with test_ (sandbox) or live_ (production) — NOT apikey_
NEXT_PUBLIC_PADDLE_CLIENT_TOKEN=test_your_paddle_client_token
PADDLE_WEBHOOK_SECRET=pdl_ntfset_your_webhook_secret
# Price IDs MUST be Paddle Catalog Price IDs starting with pri_ (NOT dollar amounts like $10.90)
NEXT_PUBLIC_PADDLE_PRICE_INTERIOR=pri_01xxxxxxxxxxxxxxxxxxxxxxxx
NEXT_PUBLIC_PADDLE_PRICE_CONTRACT=pri_01xxxxxxxxxxxxxxxxxxxxxxxx
NEXT_PUBLIC_PADDLE_ENV=sandbox

# Optional App URL for magic-link credit restore
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Admin Dashboard (/admin)
ADMIN_PASSWORD=your_admin_password_here
