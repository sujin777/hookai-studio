# Gemini API
GEMINI_API_KEY=your_gemini_api_key_here

# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# Paddle Billing
NEXT_PUBLIC_PADDLE_CLIENT_TOKEN=test_your_paddle_client_token
PADDLE_WEBHOOK_SECRET=pdl_ntfset_your_webhook_secret
NEXT_PUBLIC_PADDLE_PRICE_INTERIOR=pri_interior_pack
NEXT_PUBLIC_PADDLE_PRICE_CONTRACT=pri_contract_pack
NEXT_PUBLIC_PADDLE_ENV=sandbox

# Optional App URL for magic-link credit restore
NEXT_PUBLIC_APP_URL=http://localhost:3000
